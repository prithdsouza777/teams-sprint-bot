# Server Configuration
PORT=8000
ENV=development

# Microsoft Azure Bot
MICROSOFT_APP_ID=your_microsoft_app_id
MICROSOFT_APP_PASSWORD=your_microsoft_app_password
MICROSOFT_TENANT_ID=your_microsoft_tenant_id

# Google Cloud & Gemini
GOOGLE_PROJECT_ID=your_google_project_id
GEMINI_API_KEY=your_gemini_api_key

# MongoDB
MONGODB_URL=mongodb://localhost:27017/aiscrumbot

# AWS (Polly TTS)
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1

# Application Base URL (e.g. https://scrum-bot-xxx.run.app)
BASE_URL=

# Azure Communication Services (Voice Standup)
ACS_CONNECTION_STRING=
ACS_CALLBACK_URL=

# Azure Cognitive Services (speech recognition in ACS calls)
AZURE_COGNITIVE_SERVICES_ENDPOINT=

# Voice Standup Settings
VOICE_STANDUP_WAIT_SECONDS=30
VOICE_STANDUP_SILENCE_TIMEOUT=3
VOICE_STANDUP_MAX_SILENCE_RETRIES=2
